{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Image tags under images: in netbird.example.yaml",
      "managerFilePatterns": [
        "/^netbird-server/netbird\\.example\\.yaml$/"
      ],
      "matchStrings": [
        "\\n  \\w+: (?<depName>[a-z0-9][a-z0-9./_-]*):(?<currentValue>[A-Za-z0-9][A-Za-z0-9._-]*)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "NetBird version badge in README.md",
      "managerFilePatterns": [
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "!\\[NetBird (?<currentValue>\\d+\\.\\d+\\.\\d+)\\]",
        "img\\.shields\\.io/badge/NetBird-(?<currentValue>\\d+\\.\\d+\\.\\d+)-"
      ],
      "depNameTemplate": "netbirdio/netbird-server",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "A Postgres major cannot start on the previous major's data directory",
      "matchPackageNames": [
        "postgres"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "NetBird server, dashboard and client are upgraded together",
      "matchPackageNames": [
        "netbirdio/netbird-server",
        "netbirdio/dashboard",
        "netbirdio/netbird"
      ],
      "groupName": "netbird"
    },
    {
      "description": "ruff in requirements-dev.txt and its pre-commit hook move together",
      "matchPackageNames": [
        "ruff",
        "astral-sh/ruff-pre-commit"
      ],
      "groupName": "ruff"
    },
    {
      "description": "yamllint in requirements-dev.txt and its pre-commit hook move together",
      "matchPackageNames": [
        "yamllint",
        "adrienverge/yamllint"
      ],
      "groupName": "yamllint"
    }
  ],
  "pre-commit": {
    "enabled": true
  }
}
